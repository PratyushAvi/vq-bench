node_modules/
dist/

# Built by tools/build_wasm.sh from the fork, but committed: the fork itself is
# not in this repo, so without the binary a fresh clone cannot build. Tracking
# it also means a deploy needs only Node -- no Rust toolchain in CI.
# Regenerate with tools/build_wasm.sh after any change to the crate.
#   src/wasm/

# Copied from tools/fixtures; committed for the same reason -- the page comes
# up with nothing to run on otherwise. Regenerate with tools/make_fixture.py.
#   public/data/

# Generated by test/data/make.py.
test/data/*.h5

# Quarto's intermediate render. Only the extracted fragment
# (src/generated/guide.ts) is tracked -- the build host has no Quarto, so that
# file has to be in the repo. Re-run `npm run docs` after editing docs/.
docs/.rendered/
docs/.quarto/
